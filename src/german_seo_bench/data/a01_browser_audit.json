          "zubehoer.html"
        ],
        "catalog": [
          {
            "issue": "title_changed_by_js",
            "description": "Der <title> im gerenderten DOM weicht vom Quelltext-<title> ab (per JS geändert)."
          },
          {
            "issue": "noindex_after_render",
            "description": "meta robots=noindex ist erst nach dem Rendern vorhanden (per JS eingefügt)."
          },
          {
            "issue": "content_requires_js",
            "description": "Der Hauptinhalt ist im Quelltext leer und wird erst per JS gefüllt."
          },
          {
            "issue": "canonical_only_in_render",
            "description": "Der Canonical-Link ist nur im gerenderten DOM vorhanden (per JS gesetzt)."
          },
          {
            "issue": "h1_added_by_js",
            "description": "Im Quelltext fehlt die <h1>; sie wird erst per JS eingefügt."
          },
          {
            "issue": "broken_resource",
            "description": "Die Seite fordert eine Ressource an, die mit 4xx/5xx antwortet."
          },
          {
            "issue": "client_side_redirect",
            "description": "Die Seite leitet nach dem Laden clientseitig per JS auf eine andere URL weiter."
          },
          {
            "issue": "lazy_lcp_image",
            "description": "Das größte Bild im ersten sichtbaren Bereich (der LCP-Kandidat) trägt loading=\"lazy\" und wird dadurch verzögert geladen."
          },
          {
            "issue": "layout_shift_after_load",
            "description": "Das Layout verschiebt sich nach dem Laden deutlich (CLS über 0,1), weil nachgeschobener Inhalt keinen Platz reserviert hat."
          },
          {
            "issue": "interaction_blocked",
            "description": "Ein Klick auf ein Bedienelement blockiert den Hauptthread deutlich länger als 200 ms (schlechter INP)."
          },
          {
            "issue": "script_loads_script",
            "description": "Ein Skript lädt zur Laufzeit ein weiteres Skript nach; im HTML-Quelltext steht dieses zweite Skript nicht."
          },
          {
            "issue": "blocking_script_before_css",
            "description": "Im <head> steht ein render-blockierendes Skript (ohne async/defer) vor dem Stylesheet."
          },
          {
            "issue": "link_without_href",
            "description": "Ein Link navigiert nur per JavaScript (onclick o. ä.) und hat kein href — für einen Crawler existiert das Ziel nicht."
          },
          {
            "issue": "infinite_scroll_no_pagination",
            "description": "Weitere Inhalte erscheinen erst beim Scrollen (Infinite Scroll), und es gibt keine crawlbare Paginierung."
          },
          {
            "issue": "duplicate_title",
            "description": "Mehrere Seiten der Website tragen denselben <title>."
          },
          {
            "issue": "canonical_to_noindex",
            "description": "Der Canonical-Link zeigt auf eine ANDERE Seite, die selbst noindex trägt."
          },
          {
            "issue": "redirect_chain",
            "description": "Die Adresse führt über mehrere Weiterleitungen hintereinander zum Ziel (Kette)."
          },
          {
            "issue": "pagination_404",
            "description": "Ein Link der Paginierung zeigt auf eine Seite, die mit 404 antwortet."
          },
          {
            "issue": "orphan_page_in_sitemap",
            "description": "Die Seite steht in der sitemap.xml, wird aber von keiner anderen Seite der Website verlinkt."
          },
          {
            "issue": "cloaked_content",
            "description": "Der Server liefert für Suchmaschinen-Crawler anderes HTML aus als für Besucher."
          },
          {
            "issue": "noindex_on_second_visit",
            "description": "Beim erneuten Aufruf derselben Adresse liefert der Server die Seite mit meta robots=noindex aus (sitzungsabhängige Auslieferung)."
          },
          {
            "issue": "hidden_by_css",
            "description": "Ein Textblock ist im DOM der geladenen Seite vorhanden, für Besucher aber nicht sichtbar, weil CSS ihn ausblendet."
          }
        ]
      },
